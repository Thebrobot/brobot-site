---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar';
import HeroDesktopStatic from '../components/HeroDesktopStatic.astro';
import HeroMobile from '../components/HeroMobile.astro';
import HowItWorks from '../components/HowItWorks.astro';
import AutomationEngine from '../components/AutomationEngine';
import VoicePreview from '../components/VoicePreview';
import BuiltForConversion from '../components/BuiltForConversion.astro';
import DifferentiationSection from '../components/DifferentiationSection.astro';
import FAQ from '../components/FAQ.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Footer from '../components/Footer.astro';
import { Phone, LayoutDashboard, Activity, MapPin, Star } from 'lucide-react';

const pathname = "/";

const services = [
  { name: "Brobot One — Desk Phone & VoIP", href: "/ai-phone-crm", icon: Phone },
  { name: "Brobot CRM", href: "/crm", icon: LayoutDashboard },
  { name: "Agent Broski — AI Voice Agent", href: "/conversational-ai", icon: Activity },
  { name: "iMapsPro — Apple Maps & Local SEO", href: "/local-seo", icon: MapPin },
  { name: "RevuBro — Review Automation", href: "/reputation", icon: Star },
];
---

<BaseLayout
  title="Brobot Media | AI Voice Agents, VoIP Desk Phones & Lead Automation"
  description="Brobot Media: AI voice agents, business VoIP desk phone systems, CRM, review automation, and local SEO for HVAC, plumbing, dental, real estate & 20+ industries. Book appointments 24/7."
>
  <main class="min-h-screen bg-[#020617]">
    <Navbar client:idle pathname={pathname} />
    
    <!-- Hero: static Astro on all breakpoints (no Unicorn / no Framer hero island) -->
    <div class="md:hidden"><HeroMobile /></div>
    <div class="hidden md:block"><HeroDesktopStatic /></div>
    
    <!-- Solutions / Sitelinks Block - crawlable service links for branded search -->
    <section class="py-12 md:py-16 px-4 border-t border-white/5">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-center text-[10px] md:text-[11px] font-black uppercase tracking-[0.35em] text-slate-500 mb-8">Brobot Media Solutions</h2>
        <nav class="flex flex-wrap justify-center gap-4 md:gap-6" aria-label="Brobot Media services">
          {services.map((s) => {
            const Icon = s.icon;
            return (
              <a href={s.href} class="group inline-flex items-center gap-2 px-4 py-2.5 rounded-xl border border-white/10 bg-white/[0.02] hover:border-amber-500/30 hover:bg-amber-500/5 text-white font-semibold text-sm transition-all">
                <Icon class="w-4 h-4 text-amber-500/80" />
                <span>{s.name}</span>
              </a>
            );
          })}
        </nav>
      </div>
    </section>
    
    <!-- 1-2-3 Guide -->
    <HowItWorks />
    
    <!-- The Core Engine Flow: below md = static teasers + no React; md+ = island after matchMedia -->
    <section id="automation" aria-labelledby="automation-mobile-title" class="relative bg-[#020617] overflow-hidden">
      <div class="md:hidden px-4 py-14 border-b border-white/5">
        <p class="text-center text-amber-500 font-black text-[10px] uppercase tracking-[0.5em] mb-4">System Architecture</p>
        <h2 id="automation-mobile-title" class="text-center text-3xl sm:text-4xl font-display font-black tracking-tighter text-white mb-4">
          THE <span class="text-amber-500 italic">AUTOMATION</span> ENGINE
        </h2>
        <p class="text-center text-slate-300 text-base max-w-xl mx-auto leading-relaxed mb-8 px-2">
          A proprietary central intelligence layer that handles the complexity of growth while you focus on the vision.
        </p>
        <nav class="flex flex-col gap-2.5 max-w-md mx-auto" aria-label="Automation system products">
          <a href="/conversational-ai" class="flex items-center justify-between rounded-xl border border-white/10 bg-white/[0.02] px-4 py-3.5 text-sm font-semibold text-white hover:border-amber-500/30 transition-colors">
            <span>Agent Broski — AI Voice</span>
            <span class="text-amber-500 text-xs font-black" aria-hidden="true">→</span>
          </a>
          <a href="/reputation" class="flex items-center justify-between rounded-xl border border-white/10 bg-white/[0.02] px-4 py-3.5 text-sm font-semibold text-white hover:border-emerald-500/30 transition-colors">
            <span>RevuBro — Reviews</span>
            <span class="text-emerald-400 text-xs font-black" aria-hidden="true">→</span>
          </a>
          <a href="/ai-phone-crm" class="flex items-center justify-between rounded-xl border border-white/10 bg-white/[0.02] px-4 py-3.5 text-sm font-semibold text-white hover:border-cyan-500/30 transition-colors">
            <span>Brobot One — Desk Phone & VoIP</span>
            <span class="text-cyan-400 text-xs font-black" aria-hidden="true">→</span>
          </a>
          <a href="/crm" class="flex items-center justify-between rounded-xl border border-white/10 bg-white/[0.02] px-4 py-3.5 text-sm font-semibold text-white hover:border-indigo-500/30 transition-colors">
            <span>Brobot CRM</span>
            <span class="text-indigo-400 text-xs font-black" aria-hidden="true">→</span>
          </a>
          <a href="/local-seo" class="flex items-center justify-between rounded-xl border border-white/10 bg-white/[0.02] px-4 py-3.5 text-sm font-semibold text-white hover:border-emerald-500/30 transition-colors">
            <span>iMapsPro — Apple Maps & Local SEO</span>
            <span class="text-emerald-400 text-xs font-black" aria-hidden="true">→</span>
          </a>
        </nav>
      </div>
      <div class="hidden md:block">
        <AutomationEngine client:media="(min-width: 768px)" embedded />
      </div>
    </section>

    <!-- Meet Agent Broski: Human-Grade Voice AI -->
    <section id="voice" aria-labelledby="voice-mobile-title" class="relative bg-[#020617] overflow-hidden">
      <div class="md:hidden px-4 py-14 border-t border-white/5">
        <p class="flex items-center justify-center gap-2 text-cyan-400 font-black text-[10px] uppercase tracking-[0.5em] mb-4">
          <span class="h-1.5 w-1.5 rounded-full bg-cyan-400 animate-pulse" aria-hidden="true"></span>
          Live_Transmission
        </p>
        <h2 id="voice-mobile-title" class="text-center text-3xl sm:text-4xl font-display font-black tracking-tighter text-white mb-4 leading-[0.95]">
          AI THAT SOUNDS <br />
          <span class="text-cyan-400 italic text-4xl sm:text-5xl">LIKE A HUMAN.</span>
        </h2>
        <p class="text-center text-slate-200 text-base max-w-xl mx-auto leading-relaxed mb-8 px-2">
          No robot voices. No delays. Brobot talks to your customers and books your appointments while you focus on your business.
        </p>
        <div class="flex flex-col gap-3 max-w-md mx-auto">
          <a href="/conversational-ai#voice" class="h-14 flex items-center justify-center rounded-2xl bg-white text-[#020617] font-black text-sm uppercase tracking-[0.2em] shadow-lg">
            Hear live demos
          </a>
          <a href="/contact" class="h-14 flex items-center justify-center rounded-2xl border border-white/15 text-white font-bold text-sm hover:bg-white/5 transition-colors">
            Book a 15-min call
          </a>
        </div>
      </div>
      <div class="hidden md:block">
        <VoicePreview client:media="(min-width: 768px)" embedded />
      </div>
    </section>

    <!-- Built for Conversion: Pillars of Growth -->
    <BuiltForConversion />

    <DifferentiationSection />
    
    <!-- Frequently Asked Questions -->
    <FAQ />
    
    <!-- Final Conversion Block -->
    <FinalCTA />
    

    <Footer />
  </main>
</BaseLayout>
