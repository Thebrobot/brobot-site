---
const { currentPath } = Astro.props;

const allServices = [
  { name: "Brobot One — Desk Phone & VoIP", href: "/ai-phone-crm" },
  { name: "Brobot CRM", href: "/crm" },
  { name: "Agent Broski — AI Voice Agent", href: "/conversational-ai" },
  { name: "iMapsPro — Apple Maps & Local SEO", href: "/local-seo" },
  { name: "RevuBro — Review Automation", href: "/reputation" },
];

const related = allServices.filter((s) => s.href !== currentPath).slice(0, 3);
---

{related.length > 0 && (
  <section class="py-12 md:py-16 px-4 border-t border-white/5">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-[10px] md:text-[11px] font-black uppercase tracking-[0.35em] text-slate-500 mb-6 text-center">More from Brobot Media</h2>
      <div class="flex flex-wrap justify-center gap-3 md:gap-4">
        {related.map((s) => (
          <a href={s.href} class="px-4 py-2 rounded-xl border border-white/10 bg-white/[0.02] hover:border-amber-500/30 hover:bg-amber-500/5 text-white font-semibold text-sm transition-all">
            {s.name}
          </a>
        ))}
      </div>
    </div>
  </section>
)}
