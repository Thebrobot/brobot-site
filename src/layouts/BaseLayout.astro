---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: string;
}

const { 
  title = "Brobot Media | AI Voice Agents & Lead Automation for Local Businesses",
  description = "AI-powered voice agents, CRM automation, and review management for HVAC, plumbing, dental, real estate & 20+ industries. Book appointments 24/7, never miss a lead.",
  image = "/images/brobot_landscape.webp",
  type = "website"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', Astro.site);
const ogImageURL = new URL(image, Astro.site || 'https://thebrobot.com');
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" href="/images/favicon.webp" type="image/webp" sizes="150x150" />
    <link rel="icon" href="/images/favicon.png" type="image/png" sizes="150x150" />
    
    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Brobot Media" />
    <meta property="og:locale" content="en_US" />
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    
    <!-- Additional SEO -->
    <meta name="robots" content="index, follow" />
    <meta name="googlebot" content="index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1" />

    <!-- Google tag (gtag.js) — load after window load so it does not compete with LCP on mobile -->
    <script is:inline>
      window.addEventListener('load', function () {
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=G-KEEDYJ7F12';
        document.head.appendChild(s);
        s.onload = function () {
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          window.gtag = gtag;
          gtag('js', new Date());
          gtag('config', 'G-KEEDYJ7F12');
        };
      });
    </script>
    
    <!-- DNS Prefetch / Preconnect for external domains -->
    <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <link rel="dns-prefetch" href="https://cdn.jsdelivr.net" />
    <link rel="preconnect" href="https://beta.leadconnectorhq.com" crossorigin />
    <link rel="dns-prefetch" href="https://beta.leadconnectorhq.com" />

    <!-- Font Preloading -->

    <!-- Preload critical self-hosted fonts -->
    <link rel="preload" href="/fonts/inter-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/plus-jakarta-sans-latin-800-normal.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    
    <!-- Page-specific head content (schema, etc.) -->
    <slot name="head" />
    
    <!-- Structured Data - Organization -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "@id": "https://thebrobot.com/#organization",
      "name": "Brobot Media",
      "alternateName": "The Brobot",
      "url": "https://thebrobot.com",
      "logo": "https://thebrobot.com/images/favicon.png",
      "description": "Brobot Media provides AI-powered business automation: VoIP desk phone systems, AI voice agents, CRM, review management, and local SEO for service-based businesses.",
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "sales",
        "url": "https://thebrobot.com/contact"
      }
    })} />
    <!-- WebSite schema for branded search / sitelinks -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "Brobot Media",
      "url": "https://thebrobot.com",
      "publisher": { "@id": "https://thebrobot.com/#organization" },
      "description": "AI voice agents, VoIP desk phone systems, CRM, review automation, and local SEO for local businesses."
    })} />

    <!-- LocalBusiness Schema -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "@id": "https://thebrobot.com/#localbusiness",
      "name": "Brobot Media",
      "url": "https://thebrobot.com",
      "logo": "https://thebrobot.com/images/favicon.png",
      "image": "https://thebrobot.com/images/brobot_landscape.webp",
      "description": "AI-powered voice agents, CRM automation, and review management for local businesses.",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Los Angeles",
        "addressRegion": "CA",
        "addressCountry": "US"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 34.0522,
        "longitude": -118.2437
      },
      "areaServed": "United States",
      "priceRange": "$$",
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "sales",
        "url": "https://thebrobot.com/contact"
      },
      "parentOrganization": { "@id": "https://thebrobot.com/#organization" }
    })} />

    <!-- Unicorn Studio (load only on tablet/desktop, and only when needed) -->
    <script is:inline>
      (function () {
        const TABLET_UP = '(min-width: 768px)';
        const SCRIPT_ID = 'unicornstudio-umd';
        const SCRIPT_SRC = 'https://cdn.jsdelivr.net/gh/hiunicornstudio/unicornstudio.js@v1.4.29/dist/unicornStudio.umd.js';

        function hasUnicornProject() {
          return !!document.querySelector('[data-us-project]');
        }

        function prefersReducedMotion() {
          return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        }

        function shouldLoadUnicorn() {
          return (
            window.matchMedia(TABLET_UP).matches &&
            hasUnicornProject() &&
            !prefersReducedMotion()
          );
        }

        function loadScript() {
          if (!shouldLoadUnicorn()) return;

          const existing = document.getElementById(SCRIPT_ID);
          if (existing) {
            if (window.UnicornStudio) window.UnicornStudio.init();
            return;
          }

          const s = document.createElement('script');
          s.id = SCRIPT_ID;
          s.src = SCRIPT_SRC;
          s.onload = () => {
            if (window.UnicornStudio) window.UnicornStudio.init();
          };
          document.head.appendChild(s);
        }

        /** Defer Unicorn until after first paint + idle (or first interaction) so hero text stays responsive. */
        function ensureLoadedAndInit() {
          if (!shouldLoadUnicorn()) return;
          var run = function () { loadScript(); };
          if ('requestIdleCallback' in window) {
            requestIdleCallback(run, { timeout: 4000 });
          } else {
            setTimeout(run, 2500);
          }
        }

        window.addEventListener(
          'pointerdown',
          function tryEarly() {
            if (shouldLoadUnicorn()) loadScript();
          },
          { once: true, passive: true }
        );

        window.addEventListener('load', ensureLoadedAndInit);
        document.addEventListener('astro:after-swap', ensureLoadedAndInit);
      })();
    </script>
  </head>
  <body class="antialiased selection:bg-amber-100 selection:text-amber-900">
    <slot />
    <!-- LeadConnector (HighLevel) chat widget -->
    <script src="https://beta.leadconnectorhq.com/loader.js" data-resources-url="https://beta.leadconnectorhq.com/chat-widget/loader.js" data-widget-id="697afb8edad8af891080ebef"></script>
  </body>
</html>
